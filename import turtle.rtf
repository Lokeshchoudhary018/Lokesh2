\f0\fs24 \cf0 import turtle\
\
# Set up the screen\
screen = turtle.Screen()\
screen.setup(600, 600)\
screen.bgcolor("black")  # Black background makes colors pop\
screen.title("Python Turtle Rainbow")\
\
# Set up the turtle (pen)\
pen = turtle.Turtle()\
pen.speed(0)  # Fastest drawing speed\
pen.width(15)  # Thickness of each color arc\
\
# Traditional ROYGBIV colors\
colors = ['red', 'orange', 'yellow', 'green', 'blue', 'indigo', 'violet']\
\
# Starting dimensions\
radius = 200\
x_offset = 0\
\
# Draw concentric semi-circles\
for color in colors:\
    pen.up()\
    # Position turtle at the start of the arc\
    pen.setpos(x_offset, -100)\
    pen.down()\
    \
    pen.color(color)\
    pen.setheading(90)  # Point upward to start the arc\
    \
    # Draw a 180-degree semi-circle\
    pen.circle(-radius, 180)\
    \
    # Adjust for the next smaller inner circle\
    radius -= 15\
    x_offset += 15\
\
# Hide turtle and keep window open\
pen.hideturtle()\
screen.exitonclick()\
}